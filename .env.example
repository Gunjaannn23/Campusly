# Copy this file to ".env" and fill it in. Never commit .env or share it.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# For a deployed site, e.g. https://your-site.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave EMAIL_HOST_USER empty while testing: codes are printed in the terminal.
# For real emails (Brevo example):
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# The verified sender address (shown as "Campusly <address>")
EMAIL_FROM=
